# --- Required ---
# Generate once with:  openssl rand -hex 64
SECRET_KEY_BASE=replace-me

# --- Optional ---
# Host port the SPA + API are exposed on
LUMI_PORT=47291

# Hostname (or IP) + port you'll use to reach the app. Used by Rails for
# absolute URLs (Active Storage, password-reset emails). Include the port
# if it isn't 80.
RAILS_HOST=truenas.local:47291

# ActionCable origin allowlist. Must match how the browser addresses the app.
# Comma-separated. Add every host:port combo you'll connect from.
CABLE_ALLOWED_ORIGINS=http://truenas.local:47291,http://192.168.1.10:47291

# Public-facing URL (used in confirmation/password-reset email links)
FRONTEND_URL=http://truenas.local:47291
